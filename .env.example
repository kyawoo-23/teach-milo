GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GOOGLE_CLOUD_PROJECT=demo-teach-milo
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
APP_ORIGIN=http://127.0.0.1:3000
# Passkey testing: use http://localhost:3000 and run next dev --hostname localhost.
# Production: HTTPS domain; its hostname is the stable WebAuthn relying-party ID.
# Required in production; generate at least 32 random characters.
RATE_LIMIT_SECRET=local-development-only-change-for-production
MODEL_CALLS_PER_GUEST_DAY=100
MODEL_CALLS_PER_NETWORK_DAY=300
MODEL_CALLS_PER_GLOBAL_DAY=1000
SESSION_RETENTION_DAYS=7
# Optional: Google Sign-In OAuth credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
