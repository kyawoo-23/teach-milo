{
  "name": "teachback-ai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "firebase emulators:exec --only firestore --project demo-teachback 'vitest run tests/firestore.test.ts'",
    "test:e2e": "playwright test",
    "emulators": "firebase emulators:start --only firestore --project demo-teachback --import=.emulator-data --export-on-exit=.emulator-data",
    "doctor": "node scripts/doctor.mjs",
    "cleanup": "node scripts/cleanup.mjs",
    "format": "prettier --write src tests scripts *.ts *.json *.yaml deploy README.md",
    "format:check": "prettier --check src tests scripts *.ts *.json *.yaml deploy README.md",
    "test:http": "node scripts/smoke-http.mjs",
    "record:walkthrough": "RECORD_WALKTHROUGH=1 playwright test --project=desktop --grep \"golden path\""
  },
  "dependencies": {
    "@google/genai": "2.28.0",
    "@tailwindcss/postcss": "4.3.3",
    "acorn": "8.19.0",
    "busboy": "1.6.0",
    "clsx": "2.1.1",
    "firebase-admin": "14.5.0",
    "katex": "0.16.47",
    "lucide-react": "1.54.0",
    "mammoth": "1.13.0",
    "next": "16.4.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "server-only": "0.0.1",
    "tailwindcss": "4.3.3",
    "yauzl": "3.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@types/busboy": "1.5.4",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "3.4.0",
    "firebase-tools": "15.33.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
